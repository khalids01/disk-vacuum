# Public updater verification key. Safe to embed in the application.
DISK_VACUUM_UPDATER_PUBLIC_KEY=

# Use the path locally. GitHub Actions uses TAURI_SIGNING_PRIVATE_KEY instead.
TAURI_SIGNING_PRIVATE_KEY_PATH=

# Keep the real password only in the ignored .env file and GitHub Actions secret.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
