			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCN0MyNkJFQ0RGMUQyQUMKUldTczB2SE52aVo4KzFUdDdRR1g5WGlwaWd3ZzBvK2tpOG1tc0w1YmYxTGRZRGVLZGVxYWl6WTMK",
