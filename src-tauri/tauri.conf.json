{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "DiskVacuum",
	"version": "0.1.0",
	"identifier": "com.skycanvasstudio.disk-vacuum",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "DiskVacuum",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "",
			"endpoints": ["https://github.com/khalids01/disk-vacuum/releases/latest/download/latest.json"]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
